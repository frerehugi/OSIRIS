# MiniPay Mini-App-Listing verlangt Dependency-Supply-Chain-Schutz (siehe
# MiniPay-Referenz Abschnitt 15): exakte Versionen (siehe package.json, keine
# ^/~/*-Ranges), ein Mindestalter für neue Package-Versionen, und keine
# automatischen postinstall-Scripts von Dependencies.
minimum-release-age=10080
ignore-scripts=true
