# Gleicher Supply-Chain-Schutz wie apis/app/apis/backend (MiniPay-Referenz
# Abschnitt 15) — gilt hier nicht als Listing-Pflicht (der Keeper ist kein
# Mini-App-Code und läuft nie im Browser), aber es spricht nichts dagegen,
# denselben Standard für ein Skript mit Zugriff auf eine private Wallet-Key
# durchzuziehen.
minimum-release-age=10080
ignore-scripts=true
