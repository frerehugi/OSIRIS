{
  "compilerOptions": {
    "target":                     "ES2022",
    "lib":                        ["ES2022", "DOM"],
    "module":                     "ESNext",
    "moduleResolution":           "bundler",
    "strict":                     true,
    "noUnusedLocals":             true,
    "noUnusedParameters":         true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule":          true,
    "isolatedModules":            true,
    "noEmit":                     true,
    "skipLibCheck":               true
  },
  "include": [".", "../../src/config.ts", "../../src/dcaVaultAbi.ts"]
}
